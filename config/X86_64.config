#
# ImmortalWrt X86_64 云编译配置
# 由 GitHub Actions 工作流自动使用（defconfig 展开）
# 用户可自行修改本文件增删插件，保存后重新触发工作流即可生效
#

# ============================================================
# 一、目标平台：x86_64
# ============================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# 镜像格式：仅 squashfs；不生成 VDI/VMDK/VHDX/qcow2
# 注意：CONFIG_GRUB_IMAGES 必须保持开启（默认 y），
#       否则 x86/image/Makefile 中 IMAGES-$(CONFIG_GRUB_IMAGES) 不产出
#       squashfs-combined.img（x86_64 默认的 dd/烧写固件）
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_GRUB_EFI_IMAGES is not set
# CONFIG_ISO_IMAGES is not set
# CONFIG_TARGZ_IMAGES is not set

# ============================================================
# 二、分区配置
# 默认 160MB，增加 2048MB overlay 可写空间 => 2208MB
# ============================================================
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=2208

# ============================================================
# 三、基础系统与 LuCI
# ============================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# 中文语言支持（界面默认中文）
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# Argon 主题设为默认主题
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_DEFAULT_luci-theme-argon=y
CONFIG_LUCI_LANG_zh_cn=y

# ============================================================
# 四、插件清单
# ============================================================
# 1. SmartDNS（官方 feeds 仅提供 smartdns 一个包，无 smartdns-full 变体）
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_smartdns=y

# 2. DDNSTO 内网穿透（内置中文界面，无需额外勾选语言包）
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y

# 3. AdGuardHome（kenzok8 luci 面板：首次启动时由面板自带脚本从
#    AdGuard 官方源下载预编译二进制到 /usr/bin/AdGuardHome，无需本地编译）
#    注意：不引入 kenzok8 的 adguardhome 源码包，也不开启
#          INCLUDE_binary —— 官方 24.10 feeds 的 adguardhome 0.107.57
#          与面板运行时机制（/etc/init.d/AdGuardHome）不兼容，
#          而 kenzok8 0.107.79 的 go.mod 要求 Go 1.26+，本地 Go 1.23 无法编译。
CONFIG_PACKAGE_luci-app-adguardhome=y
# 不打包二进制：由运行时按需下载，避免与面板的 /etc/init.d/AdGuardHome 冲突
# CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary is not set

# 4. OAF 应用过滤（内置中文界面，无需语言包）
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_kmod-oaf=y

# 5. TurboAcc 网络加速（内置中文界面，无需语言包）
CONFIG_PACKAGE_luci-app-turboacc=y
# 加速组件默认全部开启（Flow Offload / Shortcut-FE CM / BBR / NFT FULLCONE）
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=y

# 6. Mwan3 多线负载均衡
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# 7. Argon 主题配置（配置项见上方"三、基础系统与 LuCI"）

# 8. 带宽监控 nlbwmon
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_nlbwmon=y

# 9. EasyTier 异地组网（内置中文界面，无需语言包）
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_easytier_INCLUDE_WEBCONSOLE=y

# 10. OpenClash（唯一代理插件）
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
# OpenClash 依赖
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y

# ============================================================
# 五、USB 支持（存储 / 网卡 / HID）
# ============================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb2-pci=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_block-mount=y

# ============================================================
# 六、有线网卡驱动
# 均来自 ImmortalWrt 源码 package/kernel/linux/modules/netdevices.mk
# 与源码内核 6.6 完全匹配，不引入外部 kmod
# ============================================================
# 英特尔 i211 / 82575 / 82576 等
CONFIG_PACKAGE_kmod-igb=y
# 英特尔 I225 / I226
CONFIG_PACKAGE_kmod-igc=y
# 英特尔 PRO/1000 PCIe
CONFIG_PACKAGE_kmod-e1000e=y
# 英特尔 10G 万兆
CONFIG_PACKAGE_kmod-ixgbe=y
# 瑞昱 RTL8111
CONFIG_PACKAGE_kmod-r8168=y
# 瑞昱 RTL8169/8110SC
CONFIG_PACKAGE_kmod-r8169=y
# Realtek 万兆网卡
CONFIG_PACKAGE_kmod-r8125=y
# Intel 40G 网卡
CONFIG_PACKAGE_kmod-i40e=y
# VMware / VirtualBox 虚拟网卡
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-e1000=y

# ============================================================
# 七、常用基础工具
# ============================================================
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_diffutils=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-ipt-ipset=y

# ============================================================
# 八、编译优化设置
# ============================================================
# 显示编译耗时（便于排障）
CONFIG_BUILD_LOG_HOST=y
# 关闭无关设备型号，加快编译
CONFIG_TARGET_MULTI_PROFILE=n
# 生成固件时附带 manifest 与版本文件
CONFIG_TARGET_PER_DEVICE_ROOTFS=n
